# Server only; never use VITE_ prefixes. No live calls occur with these defaults.
ENABLE_LIVE_VOICE=false
ASSEMBLYAI_API_KEY=
ALLOWED_ORIGIN=http://localhost:5173
# local-only: localhost development, process-lifetime cap
# sites-protected: Sites dispatcher identity + explicit allowlist + durable D1 cap
VOICE_ACCESS_MODE=local-only
VOICE_ALLOWED_USER_IDS=
# Set only after the owner approves a concrete session budget. 1–2 supported.
# Each session is capped at 300 seconds. Hosted cap persists across deployments.
VOICE_MAX_SESSIONS=0

# Optional session-only entry. Requires HTTPS, Sites identity allowlist, DB and budget.
ENABLE_SESSION_KEY_INPUT=false

# Optional visitor-owned key entry. Never unlocks the stored owner-key endpoint.
ENABLE_PUBLIC_SESSION_KEY_INPUT=false
